// ===== سوق المدينة (أضف هذا داخل match /databases/{database}/documents { ... } ولا تحذف شيئاً من قواعدك الحالية) =====

    function mkAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // الإعلانات: يقرؤها كل مستخدم، ينشرها صاحبها، يبلّغ عنها الآخرون، ويقرر فيها المدير
    match /listings/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        && request.resource.data.status in ['live', 'review']
        && request.resource.data.reports == 0
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.price is int
        && request.resource.data.imgN <= 4;
      allow update: if request.auth != null && (
        // صاحب الإعلان: بِيع، تجديد، حذف (لا يستطيع إرجاع إعلان من المراجعة)
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold', 'until', 'status'])
          && (request.resource.data.status == resource.data.status || request.resource.data.status == 'removed'))
        // بلاغ من شخص آخر: مرة واحدة، ويُخفى الإعلان من البلاغ الثالث
        || (resource.data.uid != request.auth.uid
          && !(request.auth.uid in resource.data.reporters)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'reporters', 'status', 'flag'])
          && request.resource.data.reports == resource.data.reports + 1
          && request.resource.data.reporters.size() == resource.data.reporters.size() + 1
          && request.auth.uid in request.resource.data.reporters
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'review' && request.resource.data.reports >= 3))
          && existsAfter(/databases/$(database)/documents/reports/$(id + '_' + request.auth.uid)))
        || mkAdmin());
      allow delete: if mkAdmin();
    }

    // صور الإعلانات (مضغوطة)
    match /listingImages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data.size() < 400000;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || mkAdmin());
    }

    // البلاغات: بلاغ واحد لكل شخص على كل إعلان، ولا يقرؤها إلا المدير
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.listingId + '_' + request.auth.uid;
      allow read: if mkAdmin();
    }

    // المحظورون من النشر
    match /bans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || mkAdmin());
      allow write: if mkAdmin();
    }

    // محادثات البيع والشراء: لا يراها إلا الطرفان
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.auth.uid in request.resource.data.users
        && chatId == request.resource.data.listingId + '_' + request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users;
      match /messages/{m} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
